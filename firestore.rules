rules_version = '2';

// Each signed-in user can read and write only their own data:
//   users/{uid}                 profile + settings (and the v3 appData backup)
//   users/{uid}/students/{id}
//   users/{uid}/sessions/{id}
//   users/{uid}/payments/{id}
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{collection}/{docId} {
        allow read, delete: if isOwner(uid)
          && collection in ['students', 'sessions', 'payments'];
        allow create, update: if isOwner(uid)
          && collection in ['students', 'sessions', 'payments']
          && request.resource.data.id == docId;
      }
    }
  }
}
